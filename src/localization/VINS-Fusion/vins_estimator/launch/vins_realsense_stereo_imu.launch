<launch>
<!-- VINS-Fusion Stereo+IMU on RealSense D435i -->

    <arg name="rviz" default="true"/>
    <arg name="config_path" default="$(find vins)/../config/realsense_d435i/realsense_stereo_imu_config.yaml"/>

    <!-- ===== RealSense D435i 相机驱动 ===== -->
    <!-- 只开红外双目 + IMU，关 RGB/深度 -->
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="enable_color"    value="false"/>
        <arg name="enable_depth"    value="false"/>
        <arg name="enable_infra1"   value="true"/>
        <arg name="enable_infra2"   value="true"/>
        <arg name="enable_gyro"     value="true"/>
        <arg name="enable_accel"    value="true"/>

        <arg name="infra_width"     value="640"/>
        <arg name="infra_height"    value="480"/>

        <arg name="infra_fps"       value="30"/>
        <arg name="gyro_fps"        value="200"/>
        <arg name="accel_fps"       value="200"/>

        <arg name="enable_sync"     value="false"/>
        <arg name="unite_imu_method" value="linear_interpolation"/>
    </include>

    <!-- ===== VINS-Fusion 里程计 ===== -->
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen"
          args="$(arg config_path)">
        <param name="output_path" value="$(find vins)/../output/"/>
    </node>

    <!-- ===== VINS-Fusion 回环检测 ===== -->
    <node pkg="loop_fusion" type="loop_fusion_node" name="loop_fusion" output="screen"
          args="$(arg config_path)"/>

    <!-- ===== RViz ===== -->
    <node pkg="rviz" type="rviz" name="rviz" output="log"
          args="-d $(find vins)/../config/vins_rviz_config.rviz"
          if="$(arg rviz)"/>

</launch>
