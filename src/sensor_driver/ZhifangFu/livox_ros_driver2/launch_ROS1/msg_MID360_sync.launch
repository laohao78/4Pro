<launch>
  <!-- livox_camera_sync: soft-sync MID360 LiDAR + D435i Camera -->
  <node name="sync_node" pkg="livox_camera_sync" type="sync_node" output="screen">
    <param name="image_topic" value="/camera/color/image_raw"/>
    <param name="lidar_topic" value="/livox/lidar"/>
    <param name="synced_image_topic" value="/synced_image"/>
    <param name="synced_lidar_topic" value="/synced_lidar"/>
    <param name="publish_rate" value="10.0"/>
  </node>
</launch>
