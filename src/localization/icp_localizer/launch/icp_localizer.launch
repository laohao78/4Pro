<launch>
  <arg name="pcd_path" default="$(find icp_localizer)/config/mid360.yaml"/>
  <arg name="rviz" default="false"/>
  <node pkg="icp_localizer" type="icp_localizer_node" name="icp_localizer" output="screen">
    <rosparam command="load" file="$(arg pcd_path)"/>
  </node>
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find ndt_localizer)/cfgs/demo_3d.rviz" if="$(arg rviz)"/>
</launch>
